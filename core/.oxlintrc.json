{
  "env": { "browser": true, "node": true, "es2024": true },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": [
      "error",
      {
        "ignoreRestSiblings": true
      }
    ]
  },
  "globals": {
    "__MOON_BOT_VERSION__": "readonly"
  },
  "ignorePatterns": [
    "src/client/vendor/**",
    "client.js"
  ]
}
